import { admin, db } from "@/lib/supabase";
import { check } from "@/lib/http";
import { SettingsForm } from "@/components/settings-form";
import { settingsSchema } from "@/lib/settings";
import { whatsappReady } from "@/server/notifications";
export default async function Page() {
  const user = await admin();
  const result = check(
    await db().from("settings").select("value").eq("id", "main").single(),
  );
  return (
    <SettingsForm
      initial={settingsSchema.parse(result.value)}
      canEdit={user.role === "super_admin"}
      ready={whatsappReady()}
    />
  );
}
